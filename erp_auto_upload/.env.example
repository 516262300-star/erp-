ERP_LOGIN_URL=
ERP_HOME_URL=
# Browser channel: chrome means local Google Chrome, msedge means Microsoft Edge, chromium means Playwright bundled Chromium.
BROWSER_CHANNEL=chrome
# Material root folder. Link title uses this folder name.
MATERIAL_ROOT=

# ERP uses Leedis desktop login. Optional override; default uses shared local config.
ERP_CLIENT_EXE=
